#version 430
#extension GL_ARB_compute_shader : enable

#include "ddgi_common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std140, binding = 0) uniform DDGIParams {
    vec3 uOrigin;
    float uHysteresis;
    vec3 uSpacing;
    float uNormalBias;
    ivec3 uGridDims;
    int uProbeCount;
    int uFrameIndex;
    int uRaysPerProbe;
    int uProbesThisFrame;
    float uProbeRadius;
    float _pad0;
};

layout(binding = 1, rgba16f) uniform image2D uIrradianceAtlas;
layout(binding = 2, rgba16f) uniform image2D uDistanceAtlas;
layout(binding = 3) uniform samplerCube uSceneDepthCube;

layout(std140, binding = 4) uniform LightingData {
    struct DirectionalLight { vec3 direction; vec3 color; float intensity; } dirLight;
    struct PointLight {
        vec3 position; vec3 color; float intensity;
        float constant; float linear; float quadratic; float range;
    } pointLights[8];
    struct SpotLight {
        vec3 position; vec3 direction; vec3 color; float intensity;
        float innerCutOff; float outerCutOff;
        float constant; float linear; float quadratic; float range;
    } spotLights[8];
    int numPointLights;
    int numSpotLights;
};

vec3 EvaluateDirect(vec3 pos, vec3 normal) {
    vec3 result = vec3(0.03);
    vec3 lightDir = normalize(-dirLight.direction);
    result += dirLight.color * dirLight.intensity * max(dot(normal, lightDir), 0.0);
    return result;
}

vec3 FibonacciRay(int rayIndex, int rayCount) {
    float phi = 1.61803398875;
    float y = 1.0 - (2.0 * float(rayIndex) + 1.0) / float(rayCount);
    float radius = sqrt(max(0.0, 1.0 - y * y));
    float theta = 6.2831853 * fract(float(rayIndex) * phi);
    return vec3(cos(theta) * radius, y, sin(theta) * radius);
}

float TraceDepthCube(vec3 origin, vec3 dir, float maxDist) {
    float t = 0.01;
    for (int i = 0; i < 32; i++) {
        vec3 samplePos = origin + dir * t;
        float depth = texture(uSceneDepthCube, dir).r * maxDist;
        if (t >= depth) return t;
        t += max(0.15, t * 0.1);
        if (t > maxDist) break;
    }
    return maxDist;
}

void main() {
    int localProbe = int(gl_GlobalInvocationID.x);
    if (localProbe >= uProbesThisFrame) return;

    int probeIndex = (uFrameIndex * uProbesThisFrame + localProbe) % max(uProbeCount, 1);
    ivec3 coord = ProbeCoordFromIndex(probeIndex, uGridDims);
    vec3 probePos = ProbeWorldPos(coord, uOrigin, uSpacing);
    ivec2 atlasOrigin = ProbeAtlasOrigin(coord, 16, uGridDims);

    for (int ray = 0; ray < uRaysPerProbe; ray++) {
        vec3 dir = FibonacciRay(ray + probeIndex, uRaysPerProbe);
        float hitDist = TraceDepthCube(probePos, dir, uProbeRadius * 4.0);
        vec3 radiance = (hitDist >= uProbeRadius * 3.5) ? vec3(0.05) : EvaluateDirect(probePos + dir * hitDist, dir);

        vec2 octUv = OctEncode(dir);
        ivec2 texel = atlasOrigin + ivec2(octUv * 15.99);
        vec4 prevIrr = imageLoad(uIrradianceAtlas, texel);
        vec4 prevDist = imageLoad(uDistanceAtlas, texel);
        imageStore(uIrradianceAtlas, texel, vec4(mix(radiance, prevIrr.rgb, uHysteresis), 1.0));
        imageStore(uDistanceAtlas, texel, vec4(mix(hitDist, prevDist.r, uHysteresis), 0, 0, 1));
    }
}
