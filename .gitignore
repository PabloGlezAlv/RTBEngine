!RTBEngine/ThirdParty/assimp/lib/Release/x64/*.lib
!RTBEngine/ThirdParty/assimp/lib/Debug/x64/*.lib
!RTBEngine/ThirdParty/bullet3-3.25/build_msvc/lib/Release/*.lib
