# -----------------------------------------------------------------------------
# Engine Assets/ — always versioned in git.
# Overrides Visual Studio [Oo]bj/, [Bb]in/, *.obj and similar rules above.
# -----------------------------------------------------------------------------
!RTBEngine/Assets/
!RTBEngine/Assets/**
!RTBEngine/Assets/**/obj/
!RTBEngine/Assets/**/obj/**
!RTBEngine/Assets/**/bin/
!RTBEngine/Assets/**/bin/**
!RTBEngine/Assets/**/*.obj
!RTBEngine/Assets/**/*.meta

# Engine asset temp/backup files (never commit)
RTBEngine/Assets/**/*.tmp

# -----------------------------------------------------------------------------
# ThirdParty prebuilt binaries — only scripts/thirdparty-required.txt paths are tracked.
# Extra Debug builds, unused Bullet modules, .pdb, and test libs stay local only.
# -----------------------------------------------------------------------------
RTBEngine/ThirdParty/assimp/build/
RTBEngine/ThirdParty/bullet3-3.25/build_msvc/**/CMakeFiles/
RTBEngine/ThirdParty/bullet3-3.25/build_msvc/**/*.dir/

# Un-ignore parent folders so whitelisted file exceptions below can apply.
!RTBEngine/
!RTBEngine/ThirdParty/
!RTBEngine/ThirdParty/SDL2-2.32.10/
!RTBEngine/ThirdParty/SDL2-2.32.10/lib/
!RTBEngine/ThirdParty/SDL2-2.32.10/lib/x64/
